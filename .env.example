# ============================================================
# Shopify Storefront Configuration
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
#
# SECURITY NOTE:
# The VITE_ prefix exposes these values to the browser bundle.
# Only use PUBLIC Storefront Access Tokens here (read-only, client-safe).
# Do NOT put Admin API keys, API secrets, or private tokens here.
# If your token has write/admin permissions, you need a server-side proxy.
# ============================================================

# Your Shopify store domain (e.g., your-store.myshopify.com)
VITE_SHOPIFY_DOMAIN=

# Public Storefront Access Token (read-only, safe for client-side)
# Source: Shopify Admin > Settings > Apps and sales channels > Develop apps > Storefront API
VITE_SHOPIFY_STOREFRONT_TOKEN=
